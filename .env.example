# Puerto HTTP del manager.
MANAGER_PORT=8090

# Obligatorio, 32+ caracteres. Debe coincidir con el del backend.
INTERNAL_TOKEN=cambiame-por-un-token-de-32-o-mas-caracteres

# Base del backend para el callback /internal/provision/ready.
BACKEND_URL=http://backend:3000

# Obligatorio. Ruta absoluta que contiene scripts/deploy.sh.
ALICE_OPS_DIR=/opt/alice-ops

# Valor de --node para deploy.sh.
ALICE_NODE=local

# Timeout de deploy.sh (el manager lo aplica con execFile).
PROVISION_TIMEOUT_MS=180000

# Compartido por toda la flota. deploy.sh rechaza "latest".
LETTA_TAG=0.34.39

# Falsa por ahora: LiteLLM corre en local.
LITELLM_BASE_URL=http://litellm:4000

# Opcional: fallback cuando el body de /provision no trae apiKey.
# La key real es por usuario; esto solo sirve para pruebas locales.
# LITELLM_API_KEY=sk-virtual-de-pruebas

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# development | test | production
NODE_ENV=development
